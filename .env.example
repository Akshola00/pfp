# Copy to .env.local for local dev, and set the same values in your host's
# dashboard for production. Everything here is optional — the site builds and
# runs with none of it set.

# Canonical origin, no trailing slash. Used for metadataBase, canonical URLs,
# Open Graph image URLs, robots.txt and sitemap.xml.
# Defaults to https://akinshola.dev when unset.
NEXT_PUBLIC_SITE_URL=https://akinshola.dev

# Contact form destination. Leave empty and the form falls back to opening a
# pre-filled mail draft — no service needed.
# To collect submissions instead, create a free form at https://formspree.io
# and paste its endpoint here:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_CONTACT_ENDPOINT=
